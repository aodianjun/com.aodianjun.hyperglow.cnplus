<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="io.github.libxposed.permission.BIND_XPOSED_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 获取应用列表:用于枚举已安装的音乐应用(网易云/QQ音乐等),以按需补全歌词源/检测可用播放器 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.android.systemui" />
        <package android:name="com.miui.aod" />
    </queries>

    <application
        android:name=".HyperGlowApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 主界面：始终启用。声明 Xposed 模块入口 category，让 LSPosed 管理器在隐藏桌面图标后
             仍能通过该 category 启动本应用。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标入口：真正的 LAUNCHER。隐藏桌面图标时仅禁用该 alias，
             不影响 MainActivity 本身，从而保留 LSPosed 的启动入口。 -->
        <activity-alias
            android:name=".ui.MainActivityAlias"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".bridge.SpicyLyricBridgeService"
            android:exported="true"
            android:stopWithTask="false" />

        <receiver
            android:name=".diagnostics.DiagnosticCaptureTimeoutReceiver"
            android:exported="false" />

        <service
            android:name=".aod.AodLyricBridgeService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="AOD lyric bridge for SystemUI" />
        </service>

        <provider
            android:name=".bridge.SpicyLyricBridgeProvider"
            android:authorities="${applicationId}.spicybridge"
            android:exported="true"
            android:grantUriPermissions="true">
            <grant-uri-permission android:pathPrefix="/" />
        </provider>

        <service
            android:name=".producer.LyricInfoNotificationListener"
            android:exported="false"
            android:label="@string/lyric_info_notification_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
