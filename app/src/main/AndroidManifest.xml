<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="io.github.libxposed.permission.BIND_XPOSED_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.android.systemui" />
        <package android:name="com.miui.aod" />
        <package android:name="org.lsposed.manager" />
    </queries>

    <!-- enableOnBackInvokedCallback:预测性返回手势(API 33+)的显式开关。App 内导航
         走 miuix-nav 的 NavDisplay,它经 androidx.navigationevent 接收逐帧返回进度。

         forceQueryable(上游 84a0c9ce 项 #4):声明本应用对所有应用可见。Android 11+ 的包
         可见性只认**调用方**的 <queries>——本桥的调用方是 Spotify 宿主进程(Spicy EX 以
         Xposed 模块注入其中),它不会为 CN+ 声明 queries,所以被调方一侧得自己声明。

         两点边界(照 AOSP 实现写,别照字面语义想):
         1. AppsFilterImpl.addPackageInternal 只在 `newPkgSetting.isSystem()` 成立时才读这个
            标志(与 mSystemAppsQueryable / config_forceQueryablePackages 同在 isSystem 的
            合取里),**普通用户安装的 Xposed 模块因此不生效**;系统安装(priv-app / 预装)
            或调用方持有 QUERY_ALL_PACKAGES 才是它真正落地的条件。保留此声明是为了与上游
            对齐并在系统安装场景下生效,它本身不改变用户安装时的行为。
         2. 包可见性 ≠ 授权:它只放开「看得见」。两端仍各自校验调用方 UID
            (见 bridge/CallerValidator.isSpotify / isSystemUi)。 -->
    <application
        android:name=".HyperGlowApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:forceQueryable="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 主界面：始终启用。声明 Xposed 模块入口 category 供 LSPosed 的“设置”入口使用，
             同时声明 CATEGORY_INFO 供 LSPosed 的“启动”入口(getLaunchIntentForPackage 优先
             解析 CATEGORY_INFO)使用，从而在隐藏桌面图标(仅禁用下方 alias)后仍可启动本应用。
             CATEGORY_INFO 不会在桌面生成图标，因此不会产生重复图标。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>

        <!-- 桌面图标入口：真正的 LAUNCHER。隐藏桌面图标时仅禁用该 alias，
             不影响 MainActivity 本身，从而保留 LSPosed 的启动入口。 -->
        <activity-alias
            android:name=".ui.MainActivityAlias"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".bridge.SpicyLyricBridgeService"
            android:exported="true"
            android:stopWithTask="false" />

        <receiver
            android:name=".diagnostics.DiagnosticCaptureTimeoutReceiver"
            android:exported="false" />

        <service
            android:name=".aod.AodLyricBridgeService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.STATUS_BAR_SERVICE"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="AOD lyric bridge for SystemUI" />
        </service>

        <provider
            android:name=".bridge.SpicyLyricBridgeProvider"
            android:authorities="${applicationId}.spicybridge"
            android:exported="true"
            android:grantUriPermissions="true">
            <grant-uri-permission android:pathPrefix="/" />
        </provider>

        <provider
            android:name=".bridge.CustomFontProvider"
            android:authorities="${applicationId}.customfont"
            android:exported="true" />

        <service
            android:name=".producer.LyricInfoNotificationListener"
            android:exported="false"
            android:label="@string/lyric_info_notification_listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
